#!/usr/bin/env bash
# Public-repo leak guard and skill contract. Enable with:  git config core.hooksPath .githooks
# ponytail: the contract check reads the working tree, not the index. The full
# hand-off gate is scripts/release-check.sh, because hooks can be skipped.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/check-no-leaks.py"
exec python3 "$root/scripts/check-skill-contract.py"
